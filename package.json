{
  "name": "@ai-1luvc0d3/metabase-mcp",
  "mcpName": "io.github.1luvc0d3/metabase-mcp",
  "version": "2.0.0",
  "description": "MCP server connecting Claude to Metabase for data analysis",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "metabase-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1luvc0d3/metabase-mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "demo:setup": "node demo/setup.mjs",
    "demo:verify": "node demo/verify.mjs",
    "demo:record": "node demo/record.mjs",
    "test:watch": "vitest",
    "validate-config": "node dist/validate-config.js",
    "build:mcpb": "npm run build && node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "metabase",
    "mcp",
    "claude",
    "anthropic",
    "model-context-protocol",
    "sql",
    "data-analysis"
  ],
  "author": "PyMlandBeyond",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.0.0",
    "playwright": "^1.56.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
