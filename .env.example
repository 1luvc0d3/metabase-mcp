# =============================================================================
# Metabase MCP Server - Environment Configuration
# =============================================================================

# Required: Your Metabase instance URL
METABASE_URL=https://your-metabase-instance.example.com

# Required: Metabase API key
# Generate one in Metabase Admin > Settings > API Keys
METABASE_API_KEY=mb_your_api_key_here

# Alternative to METABASE_API_KEY: a Metabase session token (X-Metabase-Session).
# Sessions expire (14 days by default). Ignored when METABASE_API_KEY is set.
# METABASE_SESSION_TOKEN=

# Server mode: read | write | full (default: read)
MCP_MODE=read

# Performance tuning
METABASE_TIMEOUT=30000
METABASE_MAX_ROWS=10000

# Logging
LOG_LEVEL=info
# AUDIT_LOG_FILE=./audit.log

# Rate limiting (per-tier, requests per minute)
# RATE_LIMIT_READ_PER_MINUTE=120
# RATE_LIMIT_WRITE_PER_MINUTE=30
# RATE_LIMIT_LLM_PER_MINUTE=20
# Legacy: applies to the read tier when RATE_LIMIT_READ_PER_MINUTE is unset
# RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Per-tool access control (comma-separated tool names; deny wins over allow)
# Also enforced inside batch_execute and run_workflow operations
# MCP_TOOLS_ALLOW=list_dashboards,get_dashboard,execute_card
# MCP_TOOLS_DENY=execute_query,delete_card,delete_dashboard

# Column redaction (comma-separated column names, case-insensitive, * wildcard)
# Applied to every query result before it reaches the AI client or in-server LLM
# MCP_REDACT_COLUMNS=email,phone*,*_ssn
# MCP_REDACT_MODE=mask   # mask (replace with [REDACTED]) or drop (remove columns)

# =============================================================================
# NLQ Features (optional - requires Anthropic API key)
# =============================================================================
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_DAILY_TOKEN_LIMIT=100000
# LLM_MONTHLY_TOKEN_LIMIT=2000000

# =============================================================================
# Shared HTTP server (Docker image, or MCP_TRANSPORT=http) - see docs/docker.md
# =============================================================================
# The Docker image already sets MCP_TRANSPORT=http, MCP_HTTP_HOST=0.0.0.0 and
# AUDIT_LOG_FILE=/data/audit.log. Every user shares METABASE_API_KEY above, so give
# that key a Metabase group with only the access you want to expose.
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3000

# One token per person: comma-separated name:token pairs. The name is stamped on
# audit events and gets its own rate limits. Generate with: openssl rand -hex 32
# Required when listening on anything other than localhost.
# MCP_AUTH_TOKENS=alice:replace-me,bob:replace-me-too

# Close sessions with no requests for this many minutes (default 30)
# MCP_SESSION_IDLE_MINUTES=30

# Only if a proxy in front of this server already authenticates every request
# MCP_ALLOW_UNAUTHENTICATED=true

# Host port docker compose publishes (default 3000)
# MCP_PUBLISH_PORT=3000
